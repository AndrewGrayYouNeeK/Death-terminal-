// Windows resources: application icon and version info.
// `zig build` does not compile this file. build.zig writes a copy whose
// FILEVERSION / ProductVersion follow `-Dversion` (default_version otherwise)
// and whose ICON path is absolute. This copy stays at 0.1.0 so the resource
// script is readable next to deathterminal.ico.
#include <winver.h>

1 ICON "deathterminal.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "YouNeeK Death Terminal"
            VALUE "FileDescription", "YouNeeK Death Terminal - Brutalist Terminal Emulator"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "deathterminal"
            VALUE "LegalCopyright", "Public domain (The Unlicense)"
            VALUE "OriginalFilename", "deathterminal.exe"
            VALUE "ProductName", "YouNeeK Death Terminal"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
