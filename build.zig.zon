.{
    .name = "deathterminal",
    .version = "0.1.0",
    .minimum_zig_version = "0.13.0",
    .dependencies = .{
        // FreeType and HarfBuzz are built from source only for Windows and
        // macOS (Linux links the system libraries); lazy, so Linux builds
        // never download them.
        .freetype = .{
            .url = "https://github.com/freetype/freetype/archive/refs/tags/VER-2-13-3.tar.gz",
            .hash = "1220179d427a4c911aa99196829e85ffc3a188b12b7a347143b6395d6c92cfc026af",
            .lazy = true,
        },
        .harfbuzz = .{
            .url = "https://github.com/harfbuzz/harfbuzz/releases/download/10.1.0/harfbuzz-10.1.0.tar.xz",
            .hash = "1220d4d0df4d68fe8d5f8282520314459de8abe5a141b5d05bb510eec0bd16692201",
            .lazy = true,
        },
        // zlib + libpng are compiled into the macOS/Windows FreeType so
        // sbix/CBDT colour bitmaps can be decoded. Lazy, like FreeType.
        .zlib = .{
            .url = "https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz",
            .hash = "1220c1854d7b4c2b5cbdd8ce6593c37e4bf1ac4032664735e1537c3848becb3b5834",
            .lazy = true,
        },
        .libpng = .{
            .url = "https://github.com/pnggroup/libpng/archive/refs/tags/v1.6.44.tar.gz",
            .hash = "12204e1bef45962fb03e45710df5f561593cdcd0b6f64e36d4f7d4d34ed5bac7563e",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "vendor",
        "assets",
        "shell-integration",
        "config.example.lua",
        "LICENSE",
        "README.md",
    },
}
